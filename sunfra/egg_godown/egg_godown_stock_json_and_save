date_default_timezone_set("Asia/Kolkata");

/* ---------------- DATABASE CONNECTION ---------------- */

$mysqli = new mysqli("localhost", "sunfra_farms", "sunfra_farms", "sunfra_farms");

if ($mysqli->connect_error) {
    echo json_encode([
        "status" => "error",
        "message" => "Database connection failed"
    ]);
    exit;
